{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kimi/moonshotai/Kimi-K2.7-Code",
  "small_model": "kimi/moonshotai/Kimi-K2.7-Code",
  "default_agent": "code",
  "instructions": [
    "AGENTS.md"
  ],
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify",
  "permission": {
    "bash": "ask",
    "edit": {
      "src/**": "allow",
      "*.lock": "deny",
      "*": "ask"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "external_directory": "deny"
  }
}
